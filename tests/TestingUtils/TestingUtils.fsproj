<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TestingUtils.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Pyxpecto" />
    <!-- Fable.Pyxpecto 2.0.0 pulls Fable.Python 5.0.0-alpha.20.1, which pins Fable.Core to exactly
         5.0.0-beta.4 and so warns (NU1608) against the Fable.Core that ARCtrl resolves. Referencing
         Fable.Python directly lifts it to the central pin, which depends on Fable.Core >= 5.0.0. -->
    <PackageReference Include="Fable.Python" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Condition="'$(FABLE_COMPILER)' != 'true'" Include="..\..\src\ROCratePCC\ROCratePCC.fsproj" />
    <ProjectReference Condition="'$(FABLE_COMPILER_JAVASCRIPT)' == 'true'" Include="..\..\src\ROCratePCC\ROCratePCC.Javascript.fsproj" />
    <ProjectReference Condition="'$(FABLE_COMPILER_TYPESCRIPT)' == 'true'" Include="..\..\src\ROCratePCC\ROCratePCC.Javascript.fsproj" />
    <ProjectReference Condition="'$(FABLE_COMPILER_PYTHON)' == 'true'" Include="..\..\src\ROCratePCC\ROCratePCC.Python.fsproj" />
  </ItemGroup>
</Project>